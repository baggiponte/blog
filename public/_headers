# Response headers for every page and file the Worker serves (Cloudflare static assets read this file).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: frame-ancestors 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Files under /_astro/ have a content hash in their name, so a changed file gets a new URL: browsers can keep them for
# a year without asking again. Cloudflare's default (max-age=0, must-revalidate) asks again on every page view.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
