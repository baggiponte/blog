{
  "name": "talks",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "dev": "pnpm build && cf dev",
    "check": "pnpm build && cf deploy --dry-run",
    "test": "playwright test",
    "deploy": "pnpm build && cf deploy",
    "typecheck": "tsc",
    "test:unit": "node --test \"scripts/*.test.ts\"",
    "lint": "biome ci .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@playwright/test": "1.64.1",
    "@slidev/cli": "53.0.0",
    "@slidev/theme-default": "0.25.0",
    "@types/d3-geo": "3.1.1",
    "@types/node": "24.19.2",
    "@types/topojson-client": "3.1.5",
    "cf": "1.0.0-beta.18",
    "d3-geo": "3.1.1",
    "topojson-client": "3.1.0",
    "typescript": "7.0.2",
    "world-atlas": "2.0.2",
    "wrangler": "4.152.0",
    "zod": "4.6.7"
  }
}
