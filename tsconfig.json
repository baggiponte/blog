{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    // Node runs the .ts build scripts and tests by stripping their types, which only works for syntax that is pure
    // annotation: no enums, namespaces or constructor parameter properties.
    "erasableSyntaxOnly": true
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
