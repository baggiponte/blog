{
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "timezone": "Europe/Rome",
  "labels": ["dependencies"],
  "commitMessagePrefix": "chore(deps):",
  "commitMessageAction": "update",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "to {{newVersion}}",
  "prTitle": "chore(deps): update {{depName}} to {{newVersion}}",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 1,
  "automerge": false,
  "platformAutomerge": false,
  "rebaseWhen": "conflicted",
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^justfile$"],
      "matchStrings": [
        "(?<depName>marimo|prek) := \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "fileMatch": [
        "^justfile$",
        "^README\\.md$",
        "^\\.pre-commit-config\\.yaml$",
        "^\\.github/workflows/.*\\.ya?ml$"
      ],
      "matchStrings": [
        "uvx --from (?<depName>[a-z0-9-]+)==(?<currentValue>\\d[^\\s`]*)"
      ],
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["astro", "@astrojs/**"],
      "groupName": "astro"
    }
  ]
}
