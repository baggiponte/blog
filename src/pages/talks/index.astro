<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Slides and recordings from Luca Baggi's talks.">
    <link rel="canonical" href="https://talks.baggiponte.com/">
    <title>talks · luca baggi</title>
    <!-- Same "theme" key and values as the blog: light by default, a saved choice wins. Runs before paint. -->
    <script>
    try {
      const saved = localStorage.getItem("theme");
      if (saved === "dark" || saved === "light") document.documentElement.dataset.theme = saved;
    } catch {}
    </script>
    <link rel="stylesheet" href="/style.css">
  </head>
  <body>
    <header class="top">
      <div class="bar">
        <a class="brand" href="https://baggiponte.com/">luca baggi<i>.</i></a>
        <nav class="tabs" aria-label="Main">
          <a class="tab" href="https://baggiponte.com/">writing</a>
          <a class="tab" href="https://baggiponte.com/about/">about</a>
          <a class="tab active" href="/" aria-current="page">talks</a>
        </nav>
        <button class="theme-toggle" type="button" aria-label="Toggle dark mode">
          <svg
            class="moon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M20.5 13.5A8.5 8.5 0 1 1 10.5 3.5a6.5 6.5 0 0 0 10 10z" />
          </svg>
          <svg
            class="sun"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" />
          </svg>
        </button>
      </div>
    </header>
    <main>
      <header>
        <h1>talks</h1>
        <p>slides, code and recordings from the times i got on stage.</p>
      </header>
      <nav class="views" aria-label="View">
        <a href="#map" data-view="map">map</a>
        <a href="#talks" data-view="talks">by talk</a>
        <a href="#timeline" data-view="timeline">timeline</a>
      </nav>
      <!-- talks -->
      <section class="timeline" aria-label="Timeline">
        <!-- timeline -->
      </section>
      <section class="map" aria-label="Map">
        <!-- map -->
      </section>
    </main>
    <footer>
      <span>these are historical talks: examples reflect the tools available when presented.</span>
      <span class="links"
        ><a href="https://baggiponte.com/">blog</a><a href="https://github.com/baggiponte/talks">github</a></span
      >
    </footer>
    <script type="module" src="/main.js"></script>
  </body>
</html>
