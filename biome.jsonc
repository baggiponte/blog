{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    // The code that came from the talks site, the build and the tests. The blog's own files and the .astro pages
    // (whose frontmatter Biome doesn't link to the template yet) aren't covered yet. Decks are kept as imported.
    "includes": [
      "*.ts",
      "biome.jsonc",
      "scripts/**",
      "tests/**",
      "src/talks/**",
      "src/scripts/talks.ts",
      "src/styles/talks.css"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "arrowParentheses": "asNeeded" } },
  "html": { "formatter": { "enabled": true }, "linter": { "enabled": true } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        // `value!` says "this is never missing here"; the tests and the timeline lean on it.
        "noNonNullAssertion": "off",
        // The stylesheet relies on source order for overrides (phones, the map card), not on specificity.
        "noDescendingSpecificity": "off"
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
